rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // =========================================================================
    // HELPER FUNCTIONS
    // =========================================================================

    // Check if the user is authenticated (logged in)
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Check if the user has true 'admin' role from their user profile
    function isAdmin() {
      return isAuthenticated() && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Check if the user is a faculty member (using faculty_roles collection)
    function isFaculty() {
      return isAuthenticated() && 
        exists(/databases/$(database)/documents/faculty_roles/$(request.auth.uid));
    }

    // Check if the user is a faculty admin
    function isFacultyAdmin() {
      return isFaculty() && 
        get(/databases/$(database)/documents/faculty_roles/$(request.auth.uid)).data.role == 'faculty_admin';
    }

    // =========================================================================
    // COLLECTION RULES
    // =========================================================================

    // -------------------------------------------------------------------------
    // Users Collection
    // Profiles for Students and Admins (Authenticated Users)
    // -------------------------------------------------------------------------
    match /users/{userId} {
      // Users can read/update their own profile. Admins can manage all.
      allow read: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      allow create: if isAuthenticated() && request.auth.uid == userId;
      allow update: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      allow delete: if isAdmin();
    }

    // -------------------------------------------------------------------------
    // Faculty Collection
    // -------------------------------------------------------------------------
    match /faculty/{facultyId} {
      // PUBLIC READ REQUIRED:
      // The current Faculty Login system uses a custom ID/Password check against 
      // this collection WITHOUT signing into Firebase Auth first. 
      // Therefore, they are "unauthenticated" guests.
      allow read: if true;
      
      // Only Admins (who are authenticated) can create/edit faculty.
      allow write: if isAdmin();

      // Allow unauthenticated faculty to manage their personal subjects
      // TODO: Secure this by migrating Faculty to Firebase Auth
      match /personal_subjects/{subjectId} {
        allow read, write: if true;
      }
    }

    // -------------------------------------------------------------------------
    // Subjects Collection (Timetables)
    // -------------------------------------------------------------------------
    match /{path=**}/subjects/{subjectId} {
      // PUBLIC READ REQUIRED:
      // Since Faculty are not signed into Firebase Auth, they cannot pass an 
      // isAuthenticated() check. Use 'true' to allow them to view schedules.
      allow read: if true;
      
      // Only Admins can manage subjects.
      // Faculty can also update (for Proxy) but strictly speaking we should limit fields.
      // For now, allow full update if Faculty.
      allow write: if isAdmin() || isFaculty();
    }

    // -------------------------------------------------------------------------
    // Audit Logs
    // -------------------------------------------------------------------------
    match /audit_logs/{logId} {
      allow read, create: if isAdmin();
      allow update, delete: if false; // Immutable
    }
    
    // -------------------------------------------------------------------------
    // Faculty Roles (Mapping UID to Role)
    // -------------------------------------------------------------------------
    match /faculty_roles/{userId} {
      // Allow authenticated users to write their own role map entry (done by app on login)
      // This is slightly loose but necessary without Cloud Functions. 
      // We assume the app logic restricts what is written.
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && request.auth.uid == userId;
    }

    // -------------------------------------------------------------------------
    // Students Collection
    // -------------------------------------------------------------------------
    match /students/{path=**} {
      // Allow read/write for all. Access is gated by the app's login screens.
      allow read, write: if true;
    }

    // Required for collectionGroup queries used in division-wide student fetching
    match /{path=**}/entries/{studentId} {
      allow read: if true;
    }

    // -------------------------------------------------------------------------
    // Attendance Collection
    // -------------------------------------------------------------------------
    match /attendance/{path=**} {
      // Allow read/write for all. Access is gated by the app's login screens.
      allow read, write: if true;
    }

    // Required for collectionGroup queries used in student stats
    match /{path=**}/dates/{dateId} {
      allow read: if true;
    }

    // -------------------------------------------------------------------------
    // Warnings Subcollection
    // -------------------------------------------------------------------------
    match /users/{userId}/warnings/{warningId} {
      // Users can read their own warnings. Faculty can write them.
      allow read: if isAuthenticated() && (request.auth.uid == userId || isAdmin() || isFaculty());
      allow create: if isAdmin() || isFaculty();
      allow update, delete: if isAdmin();
    }
  }
}
